
{
  "manifest_version": 3,
  "name": "YouTube Scroll Volume (BETA)",
  "version": "1.0.0",
  "description": "THIS EXTENSION IS FOR BETA TESTING. Adjust YouTube video volume using your mouse scroll wheel.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],

  "icons": {
  "16": "icon16.png",
  "48": "icon48.png",
  "128": "icon128.png"
  },

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
        "16":"icon16.png",
        "48":"icon48.png"
    }
  }
}
